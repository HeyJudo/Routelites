{
  "expo": {
    "name": "RouteLite",
    "slug": "routelite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "routelite",
    "backgroundColor": "#f3faf7",
    "splash": {
      "backgroundColor": "#f3faf7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00796b"
      },
      "package": "com.anonymous.routelite"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ]
  }
}
