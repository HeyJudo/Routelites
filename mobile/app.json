{
  "expo": {
    "name": "RouteLite",
    "slug": "routelite",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "routelite",
    "backgroundColor": "#f3faf7",
    "splash": {
      "backgroundColor": "#f3faf7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pup.routelite"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00796b"
      },
      "package": "com.pup.routelite",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAd3zz8Wp4GPijgCOjA-Af0ze4KO1iQdcs"
        }
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5090f21b-a3a9-4d3e-b574-26d13e20a0c5"
      }
    }
  }
}
